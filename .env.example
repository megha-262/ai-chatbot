# Copy this file to .env.local and fill in your own values.
# Never commit real credentials — .env.local is gitignored.

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthbot-ai?retryWrites=true&w=majority

# Gemini API key (server-side only, never exposed to the browser)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secret used to sign session JWTs (server-side only). Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
